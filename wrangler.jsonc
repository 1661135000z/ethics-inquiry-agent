{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inquire-experience",
  "main": "edge/worker.py",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["python_workers"],
  "assets": {"directory": "web/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"]},
  "observability": {"enabled": false},
  "vars": {"DEMO_ACCESS_ENABLED":"true"},
  "d1_databases": [{"binding":"DB","database_name":"inquire-sessions","database_id":"c35d6d10-bb97-423a-971b-537e32c484cf"}]
}
