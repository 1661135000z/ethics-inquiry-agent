# Copy to .streamlit/secrets.toml locally OR paste into Community Cloud Secrets.
# Configure ONE provider to start. Never commit real keys.
GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-2.5-flash-lite"
# Change to true ONLY after checking this project's billing is free-tier/no paid billing.
GEMINI_FREE_TIER_CONFIRMED = "false"

OPENROUTER_API_KEY = ""
OPENROUTER_MODEL = "openrouter/free"

ZHIPU_API_KEY = ""
ZHIPU_MODEL = "glm-4.7-flash"
ZHIPU_FREE_TIER_CONFIRMED = "false"

# Optional shared access code. Share separately with reviewers; never with the repo.
ACCESS_CODE = ""
