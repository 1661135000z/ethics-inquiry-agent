# Copy to .env locally; never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FREE_TIER_CONFIRMED=false
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.7-flash
ZHIPU_FREE_TIER_CONFIRMED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
ACCESS_CODE=

# Opt-in bounded public demonstration; private access is the default.
DEMO_ACCESS_ENABLED=false
# Optional developer-funded backup; shown only after a GLM service failure.
DEEPSEEK_API_KEY=
